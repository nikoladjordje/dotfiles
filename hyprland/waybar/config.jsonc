{
  "layer": "top",
  "position": "top",
  "height": 35,
  "spacing": 3,
  // "margin-top": 8,
  // "margin-top": 5,
  // "margin-right": 5,
  // "margin-left": 5,
  // "margin-bottom": 0,
  "modules-left": [
    "hyprland/workspaces",
    "custom/weather"
  ],
  "modules-center": [
    "custom/media"
  ],
  "modules-right": [
    "temperature",
    "cpu",
    "memory",
    "pulseaudio",
    "tray",
    "custom/keyboard",
    "clock",
    "custom/notification"
  ],
  "memory": {
    "format": "  {}%"
  },
  "cpu": {
    "format": "  {usage}%"
  },
  "hyprland/workspaces": {
    "disable-scroll": false,
    "format": "{id}",
    "tooltip": false,
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": []
    }
  },
  "network": {
    "format-ethernet": "  {ifname}",
    "tooltip-format": "  {ifname} via {gwaddr}",
    "format-linked": "  {ifname} (No IP)",
    "format-disconnected": " Disconnected ⚠ {ifname}",
    "format-alt": "  {ifname}: {ipaddr}/{cidr}"
  },
  "temperature": {
    "thermal-zone": 2,
    "critical-threshold": 80,
    "format-critical": " {icon} {temperatureC}°C",
    "format": " {icon} {temperatureC}°C",
    "format-icons": [
      "",
      "",
      ""
    ]
  },
  // "hyprland/language": {
  //   "format": "{}",
  //   "format-en": "ENG",
  //   "format-sr": "СРБ",
  //   "format-sr-latinyz": "SRB (Latin)",
  //   "keyboard-name": "by-tech-gaming-keyboard"
  // },
  "custom/keyboard": {
    "format": "⌨ {}",
    "exec": "~/.config/waybar/scripts/layout.sh",
    "interval": 300,
    "signal": 10
  },
  "clock": {
    // "format": "{:%H:%M}",
    // "format": "{:%H:%M %a %d %B}",
    "format": "{:%d %b %H:%M}",
    // "format-alt": "󰃮 {:%Y-%m-%d}",
    // "format-alt": "{:%d.%m.%Y}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "months": "<span color='#d3c6aa'><b>{}</b></span>",
        "days": "<span color='#e67e80'>{}</span>",
        "weeks": "<span color='#a7c080'><b>W{}</b></span>",
        "weekdays": "<span color='#7fbbb3'><b>{}</b></span>",
        "today": "<span color='#dbbc7f'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-click-forward": "tz_up",
      "on-click-backward": "tz_down",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "custom/notification": {
    "tooltip": true,
    "format": "<span size='16pt'>{icon}</span>",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂜",
      "dnd-notification": "󰂠",
      "dnd-none": "󰪓",
      "inhibited-notification": "󰂛",
      "inhibited-none": "󰪑",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰪑"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-bluetooth": "󰂰 {volume}%",
    "format-bluetooth-muted": "󰂲 {icon}",
    "format-muted": "󰝟",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󰥰",
      "headset": "󰋎",
      "phone": "󰏲",
      "portable": "󰄝",
      "car": "󰄋",
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "on-click": "pavucontrol",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +2%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -2%"
  },
  "custom/media": {
    "exec": "~/.config/waybar/scripts/media.sh",
    "interval": 5,
    "return-type": "plain",
    "max-length": 60
  },
  "custom/weather": {
    "exec": "~/.config/waybar/scripts/weather.sh",
    "interval": 1800,
    "format": "{}",
    "tooltip": true
  },
  "tray": {
    "icon-size": 18,
    "spacing": 8,
    "show-passive-items": true
  }
}
