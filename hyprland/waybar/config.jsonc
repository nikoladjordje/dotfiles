{
  "layer": "top",
  "position": "top",
  "height": 35,
  "spacing": 3,
  "margin-top": 8,
  // "margin-top": 5,
  // "margin-right": 5,
  // "margin-left": 5,
  // "margin-bottom": 0,
  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "pulseaudio",
    // "clock",
    "custom/keyboard"
  ],
  "hyprland/workspaces": {
    "disable-scroll": true,
    "format": "{name}",
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": []
    }
  },
  // "hyprland/language": {
  //   "format": "{}",
  //   "format-en": "ENG",
  //   "format-sr": "СРБ",
  //   "format-sr-latinyz": "SRB (Latin)",
  //   "keyboard-name": "by-tech-gaming-keyboard"
  // },
  "custom/keyboard": {
    "format": "⌨ {}",
    "exec": "~/.config/waybar/scripts/layout.sh",
    "interval": 300,
    "signal": 10
  },
  "clock": {
    // "format": "{:%H:%M}",
    "format": "{:%H:%M %a %d %B}",
    // "format-alt": "󰃮 {:%Y-%m-%d}",
    // "format-alt": "{:%d.%m.%Y}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "months": "<span color='#d3c6aa'><b>{}</b></span>",
        "days": "<span color='#e67e80'>{}</span>",
        "weeks": "<span color='#a7c080'><b>W{}</b></span>",
        "weekdays": "<span color='#7fbbb3'><b>{}</b></span>",
        "today": "<span color='#dbbc7f'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-click-forward": "tz_up",
      "on-click-backward": "tz_down",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-bluetooth": "󰂰 {volume}%",
    "format-bluetooth-muted": "󰂲 {icon}",
    "format-muted": "󰝟",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󰥰",
      "headset": "󰋎",
      "phone": "󰏲",
      "portable": "󰄝",
      "car": "󰄋",
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "on-click": "pavucontrol",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +2%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -2%"
  }
}
